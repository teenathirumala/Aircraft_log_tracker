# Git / Version Control
.git
.gitignore

# Docker files - these are not needed inside the image
docker-compose.yml
Dockerfile
.dockerignore
nginx.conf
render.yaml

# Node modules (if any ever exist at the root)
node_modules

# Local environment files
.env
*.env
server/.env # Explicitly ignore server env file from root context

# IDE / Editor / OS files
.vscode
.idea
*.swp
.DS_Store
Thumbs.db

# Log files
*.log
npm-debug.log*
yarn-debug.log*

# Sample data - not needed in production images
*.json 